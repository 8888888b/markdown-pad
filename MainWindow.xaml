<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MarkdownPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:pad="using:MarkdownPad.Controls"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="RootGrid_DragOver" Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ===================== title bar ===================== -->
        <!-- The right column only reserves room for the system caption buttons,
             so no custom control can overlap them. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="ThemeButton" Click="ToggleTheme_Click" Style="{StaticResource PadCaptionButtonStyle}">
                    <FontIcon x:Name="ThemeButtonIcon" FontSize="14" Glyph="&#xE793;" />
                </Button>
                <Button x:Name="LanguageButton" Style="{StaticResource PadCaptionButtonStyle}">
                    <FontIcon FontSize="14" Glyph="&#xF2B7;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem x:Name="LanguageZhItem" Click="Language_Click" Tag="zh-CN" />
                            <MenuFlyoutItem x:Name="LanguageEnItem" Click="Language_Click" Tag="en-US" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- Stretch + trimming keeps the document title inside its column so it
                 can never spill over the system caption buttons. -->
            <StackPanel
                Grid.Column="1"
                Margin="8,0,8,0"
                HorizontalAlignment="Stretch"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="DocumentTitleText"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="Markdown Pad"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DirtyIndicator" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="&#x2022;" />
            </StackPanel>

            <!-- Kept clear of the system caption buttons; width is synced in code. -->
            <Border x:Name="CaptionSpacer" Grid.Column="2" Width="140" />
        </Grid>

        <!-- ===================== toolbar ===================== -->
        <Grid Grid.Row="1" Background="{ThemeResource PadChromeBrush}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel x:Name="ToolbarPanel" Padding="10,0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

                    <Button Click="Toolbar_Click" Tag="new" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE7C3;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="open" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="save" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="saveas" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE792;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="export" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE898;" />
                    </Button>

                    <AppBarSeparator />

                    <DropDownButton x:Name="HeadingButton" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE8D3;" />
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Name="Heading1Item" Click="Toolbar_Click" Tag="h1">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8D3;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="Heading2Item" Click="Toolbar_Click" Tag="h2" />
                                <MenuFlyoutItem x:Name="Heading3Item" Click="Toolbar_Click" Tag="h3" />
                                <MenuFlyoutItem x:Name="Heading4Item" Click="Toolbar_Click" Tag="h4" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="ParagraphItem" Click="Toolbar_Click" Tag="paragraph" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button Click="Toolbar_Click" Tag="bold" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE8DD;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="italic" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE8DB;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="strike" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xEDE0;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="code" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE943;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="link" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE71B;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="image" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xEB9F;" />
                    </Button>

                    <AppBarSeparator />

                    <Button Click="Toolbar_Click" Tag="ul" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="ol" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE8EF;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="task" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE73E;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="quote" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE8BA;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="codeblock" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE7C4;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="table" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE80A;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="hr" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    </Button>

                    <AppBarSeparator />

                    <Button Click="Toolbar_Click" Tag="prevsect" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE74A;" />
                    </Button>
                    <Button Click="Toolbar_Click" Tag="nextsect" Style="{StaticResource PadToolbarButtonStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE74B;" />
                    </Button>

                    <AppBarSeparator />

                    <ToggleButton x:Name="PreviewToggle" Click="TogglePreview_Click" IsChecked="True" Style="{StaticResource PadToolbarToggleStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE890;" />
                    </ToggleButton>
                    <ToggleButton x:Name="WrapToggle" Click="ToggleWrap_Click" IsChecked="True" Style="{StaticResource PadToolbarToggleStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE7C8;" />
                    </ToggleButton>
                    <ToggleButton x:Name="PreviewThemeToggle" Click="TogglePreviewTheme_Click" Style="{StaticResource PadToolbarToggleStyle}">
                        <FontIcon FontSize="14" Glyph="&#xE706;" />
                    </ToggleButton>
                </StackPanel>
            </ScrollViewer>

            <Border
                Height="1"
                VerticalAlignment="Bottom"
                Background="{ThemeResource PadChromeBorderBrush}" />
        </Grid>

        <!-- ===================== editor + preview ===================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="560" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <!-- editor pane -->
            <Grid x:Name="EditorPane" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Background="{ThemeResource PadPaneHeaderBrush}"
                    BorderBrush="{ThemeResource PadChromeBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid Padding="12,0">
                        <TextBlock x:Name="EditorHeaderText" Style="{StaticResource PadPaneHeaderTextStyle}" Text="MARKDOWN" />
                        <TextBlock x:Name="EditorDirtyText" HorizontalAlignment="Right" Style="{StaticResource PadPaneHeaderTextStyle}" Text="" />
                    </Grid>
                </Border>

                <TextBox
                    x:Name="Editor"
                    Grid.Row="1"
                    AcceptsReturn="True"
                    Background="{ThemeResource PadEditorBackgroundBrush}"
                    BorderThickness="0"
                    FontFamily="Cascadia Mono, Consolas, Courier New"
                    FontSize="14"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    KeyDown="Editor_KeyDown"
                    Padding="14,10,14,16"
                    SelectionChanged="Editor_SelectionChanged"
                    TextChanged="Editor_TextChanged"
                    TextWrapping="Wrap"
                    UseLayoutRounding="True" />
            </Grid>

            <!-- splitter -->
            <pad:SplitterHandle
                x:Name="Splitter"
                Grid.Column="1"
                Width="6"
                Background="Transparent"
                PointerEntered="Splitter_PointerEntered"
                PointerExited="Splitter_PointerExited"
                PointerMoved="Splitter_PointerMoved"
                PointerPressed="Splitter_PointerPressed"
                PointerReleased="Splitter_PointerReleased">
                <Border Width="6" Background="Transparent">
                    <Border
                        x:Name="SplitterGrip"
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource PadGutterBrush}" />
                </Border>
            </pad:SplitterHandle>

            <!-- preview pane -->
            <Grid x:Name="PreviewPane" Grid.Column="2" Background="{ThemeResource PadEditorBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Background="{ThemeResource PadPaneHeaderBrush}"
                    BorderBrush="{ThemeResource PadChromeBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid Padding="12,0">
                        <TextBlock x:Name="PreviewHeaderText" Style="{StaticResource PadPaneHeaderTextStyle}" Text="" />
                        <TextBlock x:Name="PreviewStatusText" HorizontalAlignment="Right" Style="{StaticResource PadPaneHeaderTextStyle}" Text="" />
                    </Grid>
                </Border>

                <controls:WebView2 x:Name="Preview" Grid.Row="1" DefaultBackgroundColor="Transparent" />
            </Grid>
        </Grid>

        <!-- ===================== status bar ===================== -->
        <Grid Grid.Row="3" Background="{ThemeResource PadChromeBrush}">
            <Border Height="1" VerticalAlignment="Top" Background="{ThemeResource PadChromeBorderBrush}" />
            <Grid Padding="12,0">
                <TextBlock
                    x:Name="StatusLeft"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="" />
                <TextBlock
                    x:Name="StatusRight"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="" />
            </Grid>
        </Grid>

        <!-- ===================== drag &amp; drop overlay ===================== -->
        <Border
            x:Name="DropOverlay"
            Grid.RowSpan="4"
            Background="#88000000"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border
                Margin="40"
                Background="{ThemeResource PadEditorBackgroundBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="2"
                CornerRadius="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon FontSize="34" Glyph="&#xE8E5;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="DropTitleText" FontSize="16" FontWeight="SemiBold" Text="" />
                    <TextBlock x:Name="DropHintText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
